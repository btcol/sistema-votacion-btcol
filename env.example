# LNBits Dashboard Configuration - Read Only Mode
# Copiar este archivo a .env y completar con tus valores reales

# ============================================================================
# LNBITS SERVER CONFIGURATION
# ============================================================================

# URL de tu instancia de LNBits
# Ejemplos:
#   - Local: http://localhost:5000
#   - Red local: http://192.168.1.100:5000
#   - Remoto: https://tu-dominio.com
#   - Tor: http://tu-onion-address.onion
LNBITS_ENDPOINT=http://localhost:5000

# ============================================================================
# WALLETS CONFIGURATION
# ============================================================================

# Archivo JSON con configuración de wallets
# Copiar de wallets.example.json a wallets.json y editar con tus keys
WALLETS_CONFIG_FILE=wallets.json

# ============================================================================
# VOTACIÓN CONFIGURATION
# ============================================================================

# Conversión de sats a votos
# Ejemplo: 100 sats = 1 voto
# Los sats restantes que no completen un voto se redondean hacia abajo
SATS_PER_VOTE=100

# Mostrar tanto votos como sats en la interfaz
# true: Muestra "2340 votos (234,000 sats)"
# false: Solo muestra "2340 votos"
SHOW_SATS_AND_VOTES=true

# ============================================================================
# FLASK CONFIGURATION (Opcional)
# ============================================================================

# Modo debug (solo para desarrollo)
# true para activar, false para producción
FLASK_DEBUG=False

# Puerto (por defecto 5000)
# FLASK_PORT=5000

# Host (por defecto 0.0.0.0, que escucha en todas las interfaces)
# FLASK_HOST=0.0.0.0

# ============================================================================
# SEGURIDAD Y PRIVACIDAD
# ============================================================================

# ⚠️  IMPORTANTE: Este proyecto usa Invoice Keys (read-only)
# 
# Tipos de keys en LNBits:
#   - Admin Key: Control total (NUNCA usar aquí) ❌
#   - Invoice Key: Solo lectura (SEGURO) ✅
#
# Con Invoice Keys solo puedes:
#   ✓ Ver balance de la wallet
#   ✓ Ver historial de invoices/pagos
#   ✓ Decodificar invoices
#   ✓ Verificar estado de pagos
#
# NO puedes:
#   ✗ Crear invoices
#   ✗ Pagar invoices
#   ✗ Modificar configuración
#   ✗ Eliminar datos

# ============================================================================
# NOTAS DE SEGURIDAD
# ============================================================================

# ⚠️  Nunca versionices este archivo si contiene keys reales
# Agrega esto a .gitignore:
#   .env
#   .env.local
#   *.env
#   wallets.json

# ⚠️  Invoice Keys son relativamente seguras para usar públicamente
# ya que solo permiten lectura

# ⚠️  Mejores prácticas:
#   1. Usa Invoice Keys (no Admin Keys) como se recomienda
#   2. Rota las keys regularmente
#   3. Usa HTTPS en producción
#   4. Restringe acceso por firewall/IP si es posible
#   5. No guardes esto en control de versiones público

# ============================================================================
# CÓMO OBTENER TUS INVOICE KEYS
# ============================================================================

# 1. Abre tu instancia de LNBits
# 2. Haz clic en el nombre de la wallet (candidato1, mesa0, etc.)
# 3. Ve a "API Keys" o "Acceso a la API"
# 4. Copia la clave que dice "Invoice Key" (read-only key)
# 5. Pega en wallets.json (copiar desde wallets.example.json)

# Nota: Las Invoice Keys son la segunda clave, la más segura
# Admin Key es la primera y tiene más permisos (NO la uses en este proyecto)

# Ejemplo de cómo lucen las keys:
# Invoice Key: e1234567890abcdef1234567890abcdef1234567890abcdef1234567890abc
# Admin Key: f1234567890abcdef1234567890abcdef1234567890abcdef1234567890abc (NO USAR)
